{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interpretle",
  "main": "server/results.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-16",
  "routes": [{ "pattern": "interpretle.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "RESULTS", "class_name": "DailyResults" },
      { "name": "ANALYTICS", "class_name": "GameAnalytics" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DailyResults"] },
    { "tag": "v2", "new_sqlite_classes": ["GameAnalytics"] },
  ],
}
